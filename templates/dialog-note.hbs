<fieldset class="simplecover5e-dialog-notes" data-simplecover5e="dialog-notes">
  <legend>{{localize "SIMPLE_COVER_5E.Dialog.Legend"}}</legend>

  {{#each notes}}
  <div class="simplecover5e-dialog-note">
  <div class="form-group">
    <label>
      {{this.label}}
    </label>

    {{#if this.cover}}
    <div class="form-fields">
      <select name="{{../moduleId}}.{{this.target}}.cover">
        {{selectOptions ../coverModes selected=this.cover localize=true}}
      </select>
    </div>
    {{/if}}
  </div>
  <div class="hint">
    {{#if this.iconPath}}
    <img class="icon" src="{{this.iconPath}}" alt="" loading="lazy" width="16" height="16">
    {{else}}
      {{#if this.iconClass}}
      <i class="{{this.iconClass}}" title="{{this.label}}"></i>
      {{/if}}
    {{/if}}
    {{{this.hint}}}
  </div>
  </div>
  {{/each}}
</fieldset>
